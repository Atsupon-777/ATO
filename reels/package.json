{
  "name": "ato-reels",
  "version": "0.1.0",
  "private": true,
  "description": "ATO Reels: template-driven reel rendering with Remotion",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "app": "node app/server.ts",
    "render": "node scripts/render.mjs",
    "typecheck": "tsc --noEmit",
    "fonts": "node scripts/fetch-fonts.mjs",
    "postinstall": "node scripts/fetch-fonts.mjs",
    "app:build": "node scripts/build-native.mjs && cap sync",
    "app:ios": "node scripts/build-native.mjs && cap sync ios && cap open ios",
    "app:android": "node scripts/build-native.mjs && cap sync android && cap open android"
  },
  "dependencies": {
    "@capacitor-community/media": "^9.1.0",
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@capawesome/capacitor-file-picker": "^8.1.0",
    "@google/genai": "^2.28.0",
    "@react-three/fiber": "^9.8.2",
    "@remotion/bundler": "^4.0.534",
    "@remotion/captions": "^4.0.534",
    "@remotion/cli": "^4.0.534",
    "@remotion/elevenlabs": "^4.0.534",
    "@remotion/google-fonts": "^4.0.534",
    "@remotion/media-utils": "^4.0.534",
    "@remotion/noise": "^4.0.534",
    "@remotion/paths": "^4.0.534",
    "@remotion/player": "^4.0.534",
    "@remotion/renderer": "^4.0.534",
    "@remotion/shapes": "^4.0.534",
    "@remotion/three": "^4.0.534",
    "@remotion/transitions": "^4.0.534",
    "@remotion/zod-types": "^4.0.534",
    "@revenuecat/purchases-capacitor": "^13.7.4",
    "@types/three": "^0.170.0",
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.534",
    "three": "^0.170.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
